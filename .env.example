# Copy to .env and fill in.

# Database (Neon Postgres). In Neon: Dashboard > Connect.
# DATABASE_URL: the connection string with "Connection pooling" ON (host contains "-pooler")
# DIRECT_URL:   the same string with "Connection pooling" OFF
DATABASE_URL=""
DIRECT_URL=""

# Long random string used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Public URL of the app (used in email links)
APP_URL="http://localhost:3000"

# All times are shown and calculated in this timezone
APP_TIMEZONE="Australia/Melbourne"

# Email (optional). Without these, emails are printed to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Plover Time <no-reply@ploversecurity.com.au>"

# SMS via Twilio (optional). Leave blank to disable SMS.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
